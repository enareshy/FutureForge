# Enterprise AI Platform — environment template.
# Copy to .env (git-ignored) and adjust. NEVER commit real secrets.
# Values here are safe local-development defaults only.

# --- Deployment profile -------------------------------------------------
# development | testing | staging | production
AI_ENV=development
# Prompt-injection screening is enabled by default. Staging and production
# refuse to start with blocking disabled; detection-only is for local work.
AI_PROMPT_INJECTION_BLOCKING=true

# --- Existing enterprise backend (Node/Express, authoritative IAM) ------
# Every AI request is authenticated against the enterprise session token.
ENTERPRISE_API_BASE_URL=http://127.0.0.1:3001
ENTERPRISE_API_TIMEOUT_SECONDS=10

# --- Shared PostgreSQL (with pgvector) ----------------------------------
# Reuses the enterprise database. AI metadata lives under its own schema.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=helix
POSTGRES_USER=helix
POSTGRES_PASSWORD=change-me
AI_DB_SCHEMA=ai
# Fail startup/readiness when tenant RLS coverage is missing. Emergency
# diagnostics only; never set false in production.
AI_RLS_VERIFY=true

# --- Least-privilege database roles (SEC-19 residual risk) -------------
# provision_roles.sql creates the non-owner roles; migration 0019 binds system
# scope to ai_system_access. Staging/production require this profile and the
# exact non-owner role name. Leave both empty only for legacy local development
# before the roles are provisioned.
AI_DB_ROLE_PROFILE=
AI_DB_EXPECTED_ROLE=
# Compose uses these names instead of POSTGRES_USER for its workloads.
# WORKER_POSTGRES_USER=ai_worker
# WORKER_POSTGRES_PASSWORD=
# WORKER_DB_ROLE_PROFILE=worker
# WORKER_DB_EXPECTED_ROLE=ai_worker
# BACKUP_POSTGRES_USER=ai_backup
# BACKUP_POSTGRES_PASSWORD=
# Restore/drill always targets an isolated database with a CREATEDB role.
# RESTORE_TARGET_USER=ai_restore
# RESTORE_TARGET_PASSWORD=
# RESTORE_TARGET_ROLE_PROFILE=restore
# RESTORE_TARGET_EXPECTED_ROLE=ai_restore
# Migration login (member of ai_owner, non-owner). Uncomment together.
# AI_MIGRATION_DB_USER=ai_migrate
# AI_MIGRATION_DB_PASSWORD=
# AI_MIGRATION_ROLE=ai_owner
# Fresh install only: stop before 0019, provision roles, then rerun.
# AI_MIGRATION_STOP_AFTER=0018_tenant_row_level_security.sql

# --- Redis-compatible cache (cache/state only, never authoritative) -----
REDIS_URL=redis://127.0.0.1:6379/0

# --- Object storage (S3-compatible). Local dev uses SeaweedFS. ----------
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=ai-knowledge
# SeaweedFS (local compose) verifies no signature: any non-empty value works.
# In production supply real credentials via the secret manager.
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_FORCE_PATH_STYLE=true

# --- Backup / restore (SEC-20) -----------------------------------------
# The backup is a manual Compose profile or a Kubernetes CronJob; it is not
# started by the lean profile. Keep the passphrase in a secret manager.
# BACKUP_DIR=/backup
# BACKUP_DATABASE_SCOPE=schema
# BACKUP_OBJECTS=true
# BACKUP_RETENTION_DAYS=14
# BACKUP_RETENTION_MIN_COUNT=3
# BACKUP_REQUIRE_ENCRYPTION=false
# BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_ENCRYPTION_PASSPHRASE_FILE=
# BACKUP_OBJECT_PREFIX=
# PGPASSWORD is read from POSTGRES_PASSWORD; client binaries can be overridden
# with PG_DUMP_BIN, PG_RESTORE_BIN, PSQL_BIN, and GPG_BIN.

# --- LLM gateway --------------------------------------------------------
# When no key is configured the platform uses a clearly labelled mock.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=1536
# Provider gateway reliability bounds.
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=0.25
LLM_RETRY_MAX_DELAY_SECONDS=2.0
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
LLM_REQUESTS_PER_MINUTE=120
LLM_MAX_EMBEDDING_BATCH=64
# Optional cost metadata (USD per 1K tokens); leave empty when unknown.
LLM_INPUT_COST_PER_1K=
LLM_OUTPUT_COST_PER_1K=

# --- Enterprise full-text search ----------------------------------------
SEARCH_PROVIDER=postgres
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INSECURE=false

# --- Event streaming ----------------------------------------------------
# database (reuse enterprise outbox) | kafka | memory
EVENT_BUS_PROVIDER=database
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# AI event log / consumer (Phase 8). Kafka requires the optional aiokafka dep.
AI_EVENT_TOPIC=ai.platform.events
AI_EVENT_CONSUMER_GROUP=ai-api-events
AI_EVENT_MAX_ATTEMPTS=5
AI_EVENT_BATCH_SIZE=20
AI_EVENT_POLL_SECONDS=5
AI_EVENT_REPLAY_MAX_AGE_DAYS=7

# --- Model lifecycle (Phase 11) -----------------------------------------
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Experiment-tracking backend: auto (mlflow when a URI is set, else local),
# mlflow (require the tracking server), or local (platform registry only).
# When the configured external tracker is unreachable, runs are still recorded
# locally; nothing fails.
ML_TRACKING_BACKEND=auto
# Register model versions with the external MLflow model registry when available.
ML_ENABLE_REGISTRATION=true
ML_REQUEST_TIMEOUT_SECONDS=10
ML_DEFAULT_FRAMEWORK=scikit-learn
# Seed for the reference synthetic pipeline (scripts/ml_sample_pipeline.py).
ML_SAMPLE_SEED=1729

# --- Observability ------------------------------------------------------
# Prometheus scrapes GET /metrics with this bearer token. The API and workers
# fail closed when it is empty. Production/staging require at least 32
# characters (`openssl rand -hex 32`); the local compose token is a dev default.
# The observability compose profile mounts this value from
# infrastructure/monitoring/prometheus/local-metrics-token (git-ignored), so
# create that file before `PROFILES=observability ./scripts/up.sh`:
#   printf '%s\n' "$AI_METRICS_AUTH_TOKEN" \
#     > infrastructure/monitoring/prometheus/local-metrics-token
# Without it Docker creates an empty directory and every scrape fails with
# "unable to read authorization credentials".
AI_METRICS_AUTH_TOKEN=local-dev-metrics-token
# Interactive API docs and the OpenAPI schema are disabled in production by
# default. Set to true only for a documented, temporary requirement.
AI_DOCS_ENABLED=false
# Set OTEL_ENABLED=true to export OpenTelemetry traces to the collector.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=ai-api
# Optional Langfuse LLM tracing. Disabled unless the host AND both keys are set.
LANGFUSE_HOST=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3001

# --- AI API (FastAPI) ---------------------------------------------------
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
AI_API_LOG_LEVEL=info
AI_RATE_LIMIT_PER_MINUTE=60
# ASGI transport cap, enforced before routing/parsing (must be >= AI_UPLOAD_MAX_BYTES).
AI_MAX_REQUEST_BYTES=33554432

# --- AI persistence -----------------------------------------------------
# Persistence backend for the ai schema: postgres (default) or memory.
AI_REPOSITORY=postgres
AI_DEFAULT_PAGE_LIMIT=50
AI_MAX_PAGE_LIMIT=200

# --- Development identity ------------------------------------------------
# Used ONLY when a real identity provider is absent and AI_ENV != production.
# Production fails closed (no anonymous access). Never rely on these in prod.
AI_DEV_TENANT_ID=1
AI_DEV_ACTOR_ID=1
AI_DEV_PERMISSIONS=*:*

# --- Identity bridge (enterprise IAM) -----------------------------------
# auto (enterprise in production, development otherwise) | enterprise | development
IDENTITY_PROVIDER=auto
IDENTITY_CACHE_TTL_SECONDS=30
# JSON object overriding the AI capability -> enterprise permission map.
AI_PERMISSION_MAP=
# Enterprise permission(s) that grant unrestricted AI access (comma-separated).
AI_ADMIN_PERMISSIONS=iam.platform:read

# --- Knowledge ingestion and retrieval (Phase 7) ------------------------
# Chunking (characters) and per-request document bound.
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=120
AI_INGEST_MAX_DOCUMENTS=100
# Retrieval / RAG quality and context bounds.
AI_RAG_MIN_SCORE=0.2
AI_RAG_MAX_CONTEXT_CHARS=6000
AI_RAG_DEFAULT_LIMIT=5
AI_SEARCH_DEFAULT_LIMIT=10
# Process queued indexing jobs inline in the API process (dev convenience).
AI_INGEST_INLINE=true
# Background indexer worker (python -m ai_api.workers.indexer).
AI_WORKER_BATCH_SIZE=10
AI_WORKER_POLL_SECONDS=5

# Knowledge assistant (Stage 3): upload validation and hardened indexing jobs.
AI_UPLOAD_MAX_BYTES=26214400
AI_UPLOAD_REQUIRE_SIGNATURE=true
AI_MAX_JOB_ATTEMPTS=5
AI_JOB_TIMEOUT_SECONDS=120
AI_JOB_LEASE_SECONDS=300
# Hybrid retrieval (vector + lexical, fused with reciprocal rank fusion).
AI_HYBRID_SEARCH_ENABLED=true
AI_RRF_K=60
AI_RETRIEVAL_CANDIDATE_MULTIPLIER=4

# Enterprise search (Stage 4): explainable ranking and duplicate review bounds.
AI_SEARCH_CONSOLIDATE_DOCUMENTS=true
AI_SEARCH_EXACT_BOOST=0.5
AI_SEARCH_PHRASE_BOOST=0.3
AI_SEARCH_TITLE_BOOST=0.2
# Freshness ranking is disabled until corpus timestamps are trustworthy.
AI_SEARCH_FRESHNESS_HALF_LIFE_DAYS=0
AI_SEARCH_FRESHNESS_WEIGHT=0
AI_DEDUP_SCAN_LIMIT=5000

# Agent framework (Phase 9): timeouts, bounded iteration/tools, tracing.
AI_AGENT_DEFAULT_CODE=knowledge-assistant
AI_AGENT_DEFAULT_VERSION=1
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_MAX_ITERATIONS=6
AI_AGENT_MAX_TOOL_CALLS=6
AI_AGENT_TRACE_MAX_EVENTS=40
# Require an explicit approval token before any approval-gated tool runs.
AI_AGENT_REQUIRE_APPROVAL=false
# Stage 6 durable agent worker (python -m ai_api.workers.agent).
AI_AGENT_WORKER_BATCH_SIZE=5
AI_AGENT_EXECUTION_LEASE_SECONDS=120

# Enterprise AI Copilot (Stage 5): bounded history, derived summaries and
# authorized context assembly. Context is resolved server-side from typed refs;
# the browser never supplies document content or permissions.
AI_COPILOT_HISTORY_MAX_MESSAGES=12
AI_COPILOT_HISTORY_MAX_CHARS=12000
AI_COPILOT_SUMMARY_MAX_CHARS=2000
AI_COPILOT_SUMMARY_THRESHOLD_MESSAGES=20
AI_COPILOT_CONTEXT_MAX_ITEMS=8
AI_COPILOT_CONTEXT_MAX_CHARS=16000
AI_COPILOT_CONTEXT_CHUNK_LIMIT=6
AI_COPILOT_COMPARE_MAX_ITEMS=5
AI_COPILOT_EXTRACT_MAX_ITEMS=5
AI_COPILOT_MAX_FIELDS=25
AI_COPILOT_MAX_QUESTION_CHARS=8000
AI_COPILOT_TASK_TIMEOUT_SECONDS=60
AI_COPILOT_STREAM_ENABLED=true
AI_COPILOT_SUMMARY_ENABLED=true

# --- Service ports (host bind, loopback only) ---------------------------
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
OPENSEARCH_PORT=9200
KAFKA_PORT=9092
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
LANGFUSE_WEB_PORT=3300
