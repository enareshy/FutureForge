{
  "name": "helix-iam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Helix Identity Platform — Users, Groups & Roles",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec server/tests/*.test.js",
